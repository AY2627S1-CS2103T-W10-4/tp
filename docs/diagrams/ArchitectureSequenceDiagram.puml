@startuml
!include style.puml
skinparam ArrowFontStyle plain
actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:Model" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : "delete id/E0123"
ui -> logic : execute("delete id/E0123")
logic -> live : read roster and preferences
live --> logic : current state
logic -> candidate : create detached copy and delete target ID
logic -> storage : saveAddressBook(candidate roster)
storage -> storage : write sibling temporary file\nthen atomically replace saved file
alt save succeeds
    storage --> logic : saved
    logic -> live : publish candidate, retaining filter
    logic --> ui : deletion success
    ui --> user : deleted employee details
else save fails
    storage --> logic : IOException
    logic --> ui : save failure, live roster unchanged
    ui --> user : error, command retained
end
@enduml
