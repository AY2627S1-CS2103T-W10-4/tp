@startuml
!include style.puml
skinparam classBackgroundColor MODEL_COLOR
interface Model
interface ReadOnlyAddressBook
interface ReadOnlyUserPrefs
class ModelManager
class AddressBook
class VersionedAddressBook {
  - addressBookStateList : List<List<Employee>>
  - currentStatePointer : int
  + commit()
  + canUndo()
  + canRedo()
  + undo()
  + redo()
}
class ModelCheckpoint {
  - workingEmployees : List<Employee>
  - history : List<List<Employee>>
  - currentStatePointer : int
  - predicate : Predicate
}
class UniqueEmployeeList
class "Employee (immutable)" as Employee
class "FilteredList<Employee>" as FilteredList
class "SortedList<Employee>" as SortedList
class UserPrefs
ModelManager ..|> Model
AddressBook ..|> ReadOnlyAddressBook
VersionedAddressBook --|> AddressBook
UserPrefs ..|> ReadOnlyUserPrefs
ModelManager *-- VersionedAddressBook
ModelManager *-- FilteredList
ModelManager *-- SortedList
ModelManager *-- UserPrefs
ModelManager ..> ModelCheckpoint : capture / restore
AddressBook *-- UniqueEmployeeList
UniqueEmployeeList --> "*" Employee
FilteredList --> UniqueEmployeeList : observes existing list
SortedList --> FilteredList : orders by the current sort
VersionedAddressBook --> "*" Employee : immutable snapshots
ModelCheckpoint --> "*" Employee : copied working container
note bottom of ModelCheckpoint
History container is copied;
immutable snapshots are shared.
Effective predicate is retained by reference.
end note
@enduml
