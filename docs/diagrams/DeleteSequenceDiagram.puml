@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant ":LogicManager" as logic LOGIC_COLOR
participant ":AddressBookParser" as parser LOGIC_COLOR
participant ":DeleteCommandParser" as deleteParser LOGIC_COLOR
participant "command:DeleteCommand" as command LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:ModelManager" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

[-> logic : execute("delete id/E0123")
logic -> parser : parseCommand("delete id/E0123")
parser -> deleteParser : parse(" id/E0123")
deleteParser --> parser : DeleteCommand(EmployeeId("E0123"))
parser --> logic : command
logic -> live : getAddressBook(), getUserPrefs()
live --> logic : current roster and preferences
logic -> candidate : copy roster and preferences
logic -> command : execute(candidate)
command -> candidate : getAddressBook().getEmployeeList()
candidate --> command : complete employee roster
command -> candidate : deleteEmployee(matchingEmployee)
command --> logic : success result (not yet published)
logic -> storage : saveAddressBook(candidate.getAddressBook())
alt save succeeds
    storage --> logic : saved
    logic -> live : setAddressBook(candidate.getAddressBook())
    note right of live : Preserve filter and observable list
    [<-- logic : success result
else save fails
    storage --> logic : IOException
    note right of live : No live records or saved data changed
    [<-- logic : CommandException with save-failure message
end
@enduml
