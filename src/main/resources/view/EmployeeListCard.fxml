<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="12" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="10" bottom="8" left="14" />
  </padding>
  <Label fx:id="avatar" styleClass="avatar" text="\$initials" />
  <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
    <HBox spacing="8" alignment="BASELINE_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
      <Label fx:id="employeeId" styleClass="employee-id" text="\$employeeId" />
    </HBox>
    <Label fx:id="role" styleClass="cell_small_label" text="\$role" />
    <Label fx:id="contact" styleClass="cell_small_label, label-muted" text="\$contact" />
    <HBox spacing="6" alignment="CENTER_LEFT">
      <padding>
        <Insets top="3" bottom="0" />
      </padding>
      <Label fx:id="department" styleClass="chip" text="\$department" />
      <Label fx:id="archivedBadge" styleClass="chip, chip-archived" text="Archived" visible="false"
             managed="false" />
      <Label fx:id="manager" styleClass="chip, chip-manager" visible="false" managed="false" />
    </HBox>
  </VBox>
</HBox>
