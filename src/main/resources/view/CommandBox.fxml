<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox styleClass="command-box" alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label text="&gt;" styleClass="command-prompt" />
  <TextField fx:id="commandTextField" styleClass="text-input, text-field, command-input"
             onAction="#handleCommandEntered" promptText="Enter a command…" HBox.hgrow="ALWAYS" />
</HBox>

